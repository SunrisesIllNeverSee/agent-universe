{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": ["/app/**", "/config/**", "/requirements.txt", "/pyproject.toml", "/run.py", "/railway.json", "/Dockerfile"]
  },
  "deploy": {
    "startCommand": "/opt/venv/bin/python -m uvicorn app.server:app --host 0.0.0.0 --port $PORT --workers 4",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
